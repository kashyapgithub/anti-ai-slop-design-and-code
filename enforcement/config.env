# Configuration for the anti-ai-slop enforcement gates.
# Copy this whole `enforcement/` directory (and the matching workflow in
# .github/workflows/anti-slop-gates.yml) into your own project, then edit
# the values below to match your repo's actual layout. Nothing here is
# guessed — every value is something you should set deliberately once,
# the same way the guide asks you to write ARCHITECTURE.md deliberately.

# --- Architecture gate -------------------------------------------------
# Files that count as "the architecture is documented here". If a PR adds
# a brand-new top-level directory, one of these must also change in the
# same PR, or the gate fails. Space-separated, relative to repo root.
ARCHITECTURE_DOCS="ARCHITECTURE.md AGENTS.md CLAUDE.md docs/ARCHITECTURE.md"

# Top-level paths that are exempt from the "new folder needs a doc update"
# rule because they're not architectural (CI config, editor config, etc).
# Space-separated, matched as a prefix.
ARCHITECTURE_EXEMPT_PATHS=".github/ .vscode/ .git/ enforcement/"

# --- Integration-test gate ----------------------------------------------
# Extended-regex of path fragments that indicate a change crosses a real
# boundary (network call, DB write, queue publish, another module) and
# therefore needs an integration test, not just unit tests. Edit this to
# match your project's actual layout.
BOUNDARY_PATH_REGEX="(^|/)(api|routes|handlers|controllers|db|database|repository|repositories|queue|jobs|workers|services|clients|integrations)(/|$)"

# Extended-regex matching what counts as an integration test file.
# Defaults cover a few common conventions; keep whichever your stack uses.
INTEGRATION_TEST_REGEX="(integration|e2e)[-_.]?test|tests?/integration/|\\.integration\\.(test|spec)\\."

# Paths exempt from needing an integration test even if they match
# BOUNDARY_PATH_REGEX (e.g. pure type definitions, generated clients).
BOUNDARY_EXEMPT_REGEX="\\.d\\.ts$|/generated/|/__mocks__/"

# --- Audit runner (run-audit.sh) ----------------------------------------
# Commands for the mechanical layers of the 10-layer audit
# (anti-ai-slop-code.md, "The 10-Layer Audit" section — §18 as of this
# writing, but section numbers shift as the guide grows; search by
# heading text if this number is stale). Leave a value empty to skip that
# layer with a warning rather than a silent pass — an unset command is a
# gap you haven't configured yet, not evidence the layer succeeded. Fill
# these in with your project's actual toolchain; the examples below are
# guesses and should not be trusted as-is.
AUDIT_FORMAT_CMD=""          # e.g. "npx prettier --check ."
AUDIT_TYPECHECK_CMD=""       # e.g. "npx tsc --noEmit"
AUDIT_LINT_CMD=""            # e.g. "npx eslint ."
AUDIT_TEST_CMD=""            # e.g. "npm test"
AUDIT_INTEGRATION_TEST_CMD=""  # e.g. "npm run test:integration"
# Layers 4/5 (dependency audit, secrets/SAST) and layer 8 (architecture,
# via check-architecture.sh / check-integration-tests.sh) need git refs
# or registry access that don't fit a single reusable command — run those
# explicitly per the 10-Layer Audit section's own commands rather than
# through this variable set.

# --- Destructive-operation gate (check-destructive-ops.sh) --------------
# Backs the guide's highest-priority rule: never destroy data, not even
# by accident. Scans added/modified lines in the diff for patterns that
# are irreversible or hard to undo. A match fails the build UNLESS the
# same line (or the line directly above it) contains the confirmation
# marker below — the point isn't to forbid destructive operations
# entirely (sometimes a DROP TABLE is genuinely the right migration),
# it's to make sure one was never shipped silently.
DESTRUCTIVE_OP_REGEX="\\bDROP[[:space:]]+(TABLE|DATABASE|SCHEMA|INDEX)\\b|\\bTRUNCATE[[:space:]]+TABLE\\b|\\bDELETE[[:space:]]+FROM[[:space:]]+[A-Za-z0-9_.\"\\\`]+[[:space:]]*;|rm[[:space:]]+-rf[[:space:]]|git[[:space:]]+reset[[:space:]]+--hard|git[[:space:]]+clean[[:space:]]+-[a-z]*f|git[[:space:]]+push[[:space:]].*(--force\\b|-f\\b|--force-with-lease\\b)"

# The marker that must appear on the matched line or the line immediately
# above it for the gate to pass instead of fail. Deliberately verbose so
# it can't be added on autopilot.
DESTRUCTIVE_OP_CONFIRM_MARKER="CONFIRMED-DESTRUCTIVE: human explicitly approved this exact operation"

# File patterns to skip entirely (this repo's own test fixtures, docs
# quoting a dangerous command as an example rather than running it, and
# the enforcement/templates tooling itself, whose job is to *describe*
# these patterns in error messages and comments, not execute them).
DESTRUCTIVE_OP_EXEMPT_REGEX="\\.md$|/fixtures/|/__tests__/.*\\.snap$|^enforcement/|^templates/"

